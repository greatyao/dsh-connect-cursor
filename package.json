{
  "name": "dsh-connect-cursor",
  "version": "0.1.0",
  "description": "把本机已登录的 Cursor 模型接入 DeepSeek Harness：复用 Cursor 桌面/CLI 的登录态，逆向 agent.v1 Run 协议，原生 LlmAdapter 直连。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./adapter": "./lib/adapter.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cursor",
    "connect"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greatyao/dsh-connect-cursor.git"
  },
  "homepage": "https://github.com/greatyao/dsh-connect-cursor#readme",
  "bugs": {
    "url": "https://github.com/greatyao/dsh-connect-cursor/issues"
  }
}
